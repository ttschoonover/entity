% post.latex · the Pandoc template for a post's PDF. Latin Modern, the face the
% website reads in; the same Markdown makes the page and this.
\documentclass[11pt]{article}
\usepackage{fontspec}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}
\usepackage{polyglossia}
\setdefaultlanguage{$if(lang-fr)$french$else$english$endif$}
\usepackage[a4paper,margin=1.15in,top=1in,bottom=1.1in]{geometry}
\usepackage{microtype}
\usepackage{xcolor}
\definecolor{accent}{HTML}{9B3833}
\definecolor{dim}{HTML}{85847E}
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.6\textheight0.6\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\usepackage{longtable,booktabs,array,calc}
\usepackage{amsmath,amssymb}
\usepackage{fancyvrb}
\usepackage{upquote}
\usepackage{csquotes}
\usepackage[hang,flushmargin]{footmisc}
\usepackage{float}
\floatplacement{figure}{H}
\usepackage{caption}
\captionsetup{font={small,sf},labelformat=empty,justification=raggedright,singlelinecheck=false}
\usepackage{titlesec}
\titleformat{\section}{\normalfont\sffamily\bfseries}{}{0pt}{}
\titleformat{\subsection}{\normalfont\sffamily}{}{0pt}{}
\titlespacing*{\section}{0pt}{1.6em}{0.5em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.3em}
\usepackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\sffamily\color{dim}$author$ · $site$}
\fancyfoot[R]{\footnotesize\sffamily\color{dim}\thepage}
\usepackage[hidelinks]{hyperref}
\hypersetup{pdftitle={$title-meta$},pdfauthor={$author-meta$},colorlinks=true,linkcolor=accent,urlcolor=accent,citecolor=accent}
\urlstyle{same}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{3em}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\linespread{1.08}
\renewenvironment{quote}{\list{}{\leftmargin=1.4em\rightmargin=1.4em}\item\relax\itshape}{\endlist}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
\providecommand{\pandocbounded}[1]{#1}
\begin{document}
\thispagestyle{fancy}
\begin{flushleft}
{\sffamily\small\color{accent}$form$}\par\vspace{0.6em}
{\LARGE $title$\par}\vspace{0.7em}
{\sffamily\small\color{dim}$author$ · $date$$if(url)$ · \href{$url$}{\nolinkurl{$url-text$}}$endif$\par}
\end{flushleft}
\vspace{1.4em}
$body$
\end{document}
